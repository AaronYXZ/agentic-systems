# Copy to .env and add your own API key before running model-backed code.
OPENAI_API_KEY=

# Override this to use another model supported by your OpenAI account.
OPENAI_MODEL=gpt-5-mini

# Optional V2 live search. Mock search remains the default.
JOB_SEARCH_PROVIDER=mock
# When JOB_SEARCH_PROVIDER=jsearch, add your RapidAPI JSearch key here.
JSEARCH_API_KEY=

# Local tool metadata to stderr. No arguments or outputs are printed.
JOB_AGENT_LOCAL_TRACING=false
# Optional OpenAI SDK trace export. Sensitive payload inclusion stays disabled.
JOB_AGENT_SDK_TRACING=false

# V2-b Option B. Used by the standalone MCP adapter, not yet by the CLI.
# Set this in ignored .env only. RapidAPI credentials are not interchangeable.
OPENWEBNINJA_API_KEY=

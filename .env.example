# Copy this file to .env and add your key when you reach the LLM-backed example.
OPENAI_API_KEY=

# The OpenAI model used by the LangChain agent.
AGENT_MODEL=gpt-5-mini

# Request resilience. Keep retries low while learning so failures stay visible.
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_RETRIES=2

# Optional LangSmith observability.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-systems-course
